# Copiar a .env.local para desarrollo. NUNCA commitear valores reales.
# En Vercel estos 14 secrets ya están configurados (ver PLAN.md).

# Supabase (Auth + DB + Storage)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Email transaccional (Resend): solo la casilla verificada. El nombre visible
# sale del negocio (negocios.nombre) con fallback "TurnoMas".
RESEND_API_KEY=re_...
EMAIL_FROM=no-reply@turnomas.com

# Background tasks (Upstash QStash)
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=eyJ...
QSTASH_CURRENT_SIGNING_KEY=sig_...
QSTASH_NEXT_SIGNING_KEY=sig_...

# Google Sign-In (GIS). El Client Secret se configura solo en Supabase Auth.
GOOGLE_CLIENT_ID=...apps.googleusercontent.com

# MercadoPago plataforma (suscripción SaaS; las señas usan el token del
# negocio vía OAuth y nunca caen a esta cuenta)
MP_ACCESS_TOKEN=APP_USR-...
MP_WEBHOOK_SECRET=...

# MercadoPago OAuth (app registrada en el panel de MP para señas delegadas;
# Redirect URL exacta: https://turnomas.com/api/integrations/mercadopago/callback)
MP_CLIENT_ID=1234567890
MP_CLIENT_SECRET=...

# Suscripción SaaS (Preapproval mensual por país; defaults 14999 ARS / 15 USD)
MP_PLAN_ARS=14999
MP_PLAN_USD=15

# Margen (horas) para confirmar una renovación antes de bloquear por mora o
# vencimiento. Default 24. Evita falsos paywalls si el webhook/cron demoran.
MP_MARGEN_RENOVACION_HORAS=24

# UID legado del dueño demo: reconoce sesiones Supabase heredadas y bloquea
# escrituras. La demo actual no se guarda en la base (cookie session=demo).
DEMO_DUENIO_ID=11111111-1111-4111-8111-111111111111

# Panel admin mínimo (/admin/promociones). Configurar el mismo email en
# Vercel Production y Preview. Sin valor, la ruta responde 404 (fail-closed).
ADMIN_EMAIL=admin@turnomas.com

# Cancelación del cliente (link mágico HMAC por email/WhatsApp).
# Secreto de 32+ caracteres; sin esto la cancelación pública responde 503.
CANCELACION_SECRET=cambiar-en-produccion-32-caracteres-minimo

# URL pública de la app para QStash y callbacks OAuth (opcional: en Vercel se usa VERCEL_URL automático).
# El callback /auth/callback usa el origen del request como fallback, pero definirla evita redirecciones a
# dominios de preview. En Supabase > Authentication > URL Configuration agregar esta URL + /auth/callback.
# NEXT_PUBLIC_APP_URL=https://turnomas.com
